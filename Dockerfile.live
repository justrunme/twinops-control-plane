# Experimental TwinOps live API + static web UI image (demo only).
# Bind to localhost in production-like environments — API is unauthenticated.
FROM node:22-bookworm AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY python ./python
COPY examples ./examples
RUN pip install --no-cache-dir ".[live]"
COPY --from=web /web/dist ./web/dist
EXPOSE 8080
USER 65532:65532
ENTRYPOINT ["twinopsctl", "serve", "--host", "0.0.0.0", "--port", "8080", "--web-dist", "web/dist"]
